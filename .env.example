# --- App ---
ENVIRONMENT=development
DEBUG=true
API_HOST=127.0.0.1
API_PORT=8000
API_AUTH_TOKEN=change-me-to-a-long-random-string
CORS_ALLOWED_ORIGINS=

# --- LLM (set only the provider you use; llm_provider selects which one) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
LLM_MODEL_OVERRIDE=

# --- Browser ---
BROWSER_CHANNEL=chrome
BROWSER_HEADLESS=false
BROWSER_USER_DATA_DIR=
BROWSER_SLOW_MO_MS=0
BROWSER_DEFAULT_TIMEOUT_MS=30000

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# --- Database / Memory ---
SQLITE_PATH=./data/nexus_agent.db
CHROMA_PERSIST_DIR=./data/chroma

# --- Wallet safety policy ---
WALLET_REQUIRE_MANUAL_APPROVAL=true
WALLET_MAX_AUTO_APPROVE_VALUE_USD=0
WALLET_ALLOWLISTED_CONTRACTS=

# --- Vision / OCR perception fallback ---
VISION_ENABLED=true
VISION_MIN_ELEMENTS_THRESHOLD=3
VISION_MODEL_OVERRIDE=
OCR_ENABLED=true
OCR_LANG=eng
OCR_MAX_CHARS=4000

# --- Live browser session (real-time screenshot streaming) ---
LIVE_SESSION_ENABLED=true
LIVE_SESSION_INTERVAL_MS=1000
LIVE_SESSION_JPEG_QUALITY=60
