# --- App ---
ENVIRONMENT=development
DEBUG=true
API_HOST=127.0.0.1
API_PORT=8000
API_AUTH_TOKEN=change-me-to-a-long-random-string
CORS_ALLOWED_ORIGINS=


# --- LLM (set only the providers you use; llm_provider selects the default) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
LLM_MODEL_OVERRIDE=



# Override the request URL for Anthropic/OpenAI -- lets these two point at an
# OpenAI/Anthropic-compatible gateway (e.g. AgentRouter, Azure, a self-hosted
# proxy) instead of the real provider endpoint. Leave blank/commented to use
# the real api.anthropic.com / api.openai.com endpoints.
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions



ANTHROPIC_BASE_URL=https://agentrouter.org/v1/messages
OPENAI_BASE_URL=https://agentrouter.org/v1/chat/completions


# --- LLM: additional providers (AI Model Manager) ---
XAI_API_KEY=
MOONSHOT_API_KEY=
QWEN_API_KEY=
ZHIPU_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
COHERE_API_KEY=
HUGGINGFACE_API_KEY=
NVIDIA_NIM_API_KEY=
SAMBANOVA_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
DEEPINFRA_API_KEY=
MISTRAL_API_KEY=
REPLICATE_API_KEY=
AI21_API_KEY=


# --- AI Model Manager ---
AI_SMART_ROUTING_ENABLED=false
AI_FALLBACK_PROVIDER=openrouter
AI_PROVIDER_PRIORITY=
AI_DISABLED_PROVIDERS=



# --- Browser ---
BROWSER_CHANNEL=chrome
BROWSER_HEADLESS=true
BROWSER_USER_DATA_DIR=
BROWSER_SLOW_MO_MS=0
BROWSER_DEFAULT_TIMEOUT_MS=30000



# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=



# --- Database / Memory ---
SQLITE_PATH=./data/nexus_agent.db
CHROMA_PERSIST_DIR=./data/chroma



# --- Wallet safety policy ---
WALLET_REQUIRE_MANUAL_APPROVAL=true
WALLET_MAX_AUTO_APPROVE_VALUE_USD=0
WALLET_ALLOWLISTED_CONTRACTS=



# --- Hot signer (direct RPC send, no approval popup -- burner wallets only) ---
# The key itself is NOT set here. It's encrypted at rest in a local
# hot_signer.keystore file (backend/wallet/keystore.py), written by
# persist_hot_signer_secret() when you import a wallet with
# save_as_hot_signer=true (REST) or "save as hot signer" (chat).
# KEYSTORE_PASSPHRASE below is only the passphrase that unlocks that file --
# set it before importing, and it's required (no interactive prompt) for
# both the API and chat import paths, and for auto-unlock at server startup.
HOT_SIGNER_ENABLED=false
KEYSTORE_PASSPHRASE=
HOT_SIGNER_MAX_NATIVE_VALUE=0
# If true, EVERY private_key/seed_phrase wallet import is automatically
# saved as the hot signer, without passing save_as_hot_signer=true each
# time. Off by default -- only turn this on if you genuinely want every
# future key/phrase you paste in (REST or chat) persisted for signing.
# A single import can still override this with save_as_hot_signer=false.
HOT_SIGNER_AUTO_SAVE_ON_IMPORT=false



# --- Vision / OCR perception fallback ---
VISION_ENABLED=true
VISION_MIN_ELEMENTS_THRESHOLD=3
VISION_MODEL_OVERRIDE=
OCR_ENABLED=true
OCR_LANG=eng
OCR_MAX_CHARS=4000



# --- Live browser session (real-time screenshot streaming) ---
LIVE_SESSION_ENABLED=true
LIVE_SESSION_INTERVAL_MS=1000
LIVE_SESSION_JPEG_QUALITY=60



# --- Skill Learning System (search-before-plan matching, Teach Mode) ---
SKILLS_ENABLED=true
SKILLS_MATCH_MIN_SCORE=0.62



# --- MCP Core (filesystem/terminal/browser/github tool connectors) ---
# MCP_ENABLED is the master switch: when false, MCPManager.start() no-ops
# (no connectors are started) but state.mcp remains a constructed object, so
# the /mcp API and dashboard still respond -- they just report everything
# disabled. Use the per-connector *_ENABLED flags below for finer control.
MCP_ENABLED=true
MCP_FILESYSTEM_ENABLED=true
MCP_FILESYSTEM_ROOTS=
MCP_TERMINAL_ENABLED=true
MCP_TERMINAL_COMMANDS_ALLOWLIST=
MCP_TERMINAL_TIMEOUT_SECONDS=30
MCP_TERMINAL_WORKING_DIR=
MCP_BROWSER_ENABLED=true
MCP_BROWSER_TIMEOUT_SECONDS=20
MCP_GITHUB_ENABLED=true
MCP_GITHUB_TOKEN=
MCP_GITHUB_DEFAULT_OWNER=
MCP_GITHUB_DEFAULT_REPO=
MCP_TOOL_CALL_TIMEOUT_SECONDS=30
MCP_ROUTER_MIN_SCORE=1.0
